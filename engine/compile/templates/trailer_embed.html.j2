{# The launch trailer (`trailer.embed`, built by `studio trailer`): a button over the opening section and a modal player.
   The 9:16 cut plays on portrait screens when it exists. #}
<button class="ss-trailer-btn" type="button" aria-haspopup="dialog" data-ss-trailer>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
  <span>{{ trailer.label }}</span>
</button>
<dialog class="ss-trailer" aria-label="{{ trailer.label }}">
  <button class="ss-trailer__x" type="button" aria-label="Close">&times;</button>
  <video controls playsinline preload="none" poster="{{ trailer.poster }}" data-wide="{{ trailer.wide }}"{% if trailer.tall %} data-tall="{{ trailer.tall }}" data-tall-poster="{{ trailer.tall_poster }}"{% endif %}></video>
</dialog>
<style>
  .ss-trailer-btn { position: absolute; z-index: 40; left: clamp(16px, 3vw, 40px); top: calc(100svh - 84px);
    display: inline-flex; align-items: center; gap: .55em; padding: .7em 1.15em .7em .95em; border: 0; cursor: pointer;
    font: 600 15px/1 var(--font-body); color: var(--accent-ink); background: var(--accent); border-radius: 999px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, .28); transition: transform .25s, box-shadow .25s; }
  .ss-trailer-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 34px rgba(0, 0, 0, .34); }
  .ss-trailer-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .ss-trailer { padding: 0; border: 0; background: transparent; max-width: min(94vw, 1600px); max-height: 92svh; overflow: visible; }
  .ss-trailer::backdrop { background: rgba(0, 0, 0, .82); }
  .ss-trailer video { display: block; max-width: min(94vw, 1600px); max-height: 88svh; border-radius: 10px; background: #000; }
  .ss-trailer__x { position: absolute; z-index: 1; top: 10px; right: 10px; width: 38px; height: 38px; border: 0;
    border-radius: 50%; background: rgba(0, 0, 0, .55); color: #fff; font-size: 24px; line-height: 1; cursor: pointer; }
  .ss-trailer__x:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (max-width: 720px) { .ss-trailer-btn { top: calc(100svh - 150px); font-size: 14px; } }
  @media (prefers-reduced-motion: reduce) { .ss-trailer-btn { transition: none; } }
</style>
<script>
  (function () {
    var btn = document.querySelector("[data-ss-trailer]"), dlg = document.querySelector(".ss-trailer");
    if (!btn || !dlg || !dlg.showModal) { if (btn) btn.hidden = true; return; }
    var v = dlg.querySelector("video");
    btn.addEventListener("click", function () {
      var tall = v.dataset.tall && matchMedia("(max-aspect-ratio: 4/5)").matches;
      var src = tall ? v.dataset.tall : v.dataset.wide;
      if (v.getAttribute("src") !== src) { v.src = src; if (tall) v.poster = v.dataset.tallPoster; }
      dlg.showModal();
      var p = v.play(); if (p && p.catch) p.catch(function () {});
    });
    function close() { v.pause(); if (dlg.open) dlg.close(); }
    dlg.querySelector(".ss-trailer__x").addEventListener("click", close);
    dlg.addEventListener("click", function (e) { if (e.target === dlg) close(); });
    dlg.addEventListener("close", function () { v.pause(); });
  })();
</script>
