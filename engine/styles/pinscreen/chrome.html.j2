{# Pinscreen furniture: the board itself (one fixed canvas behind every plate) and the iron frame around it. The top
   rail carries the wordmark, the site's nav links and its CTA (the default nav is hidden); the bottom rail carries
   the plate counter, the lamp dial (where the raking light is coming from) and the pin count. #}
{% macro top(site, sections, nav_links) %}
<div class="pn-board" aria-hidden="true"><canvas class="pn-canvas"></canvas></div>
<div class="pn-frame" aria-hidden="true"></div>
<header class="pn-rail pn-rail--top">
  <a class="pn-mark" href="#"><span class="pn-mark__pin" aria-hidden="true"></span>{{ site.name }}</a>
  {% if nav_links %}<nav class="pn-links" aria-label="Plates">{% for l in nav_links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</nav>{% endif %}
  {% if site.nav.cta %}<a class="pn-rail__cta" href="{{ site.nav.cta.href }}">{{ site.nav.cta.label }}</a>{% endif %}
</header>
<div class="pn-rail pn-rail--bottom" aria-hidden="true">
  <span class="pn-hud__plate">plate <b data-pn-plate>01</b> / <span data-pn-plates>{{ "%02d" | format(sections | length) }}</span></span>
  <span class="pn-hud__lamp"><svg viewBox="-12 -12 24 24" width="22" height="22"><circle r="10.5" fill="none" stroke="currentColor" stroke-width="1"/><g data-pn-lamp><line x1="0" y1="0" x2="0" y2="-10.5" stroke="currentColor" stroke-width="1.6"/><circle cy="-10.5" r="2.4" fill="currentColor"/></g></svg>lamp <b data-pn-azimuth>NW</b></span>
  <span class="pn-hud__pins"><b data-pn-pins>—</b> pins</span>
</div>
{% endmacro %}

{% macro bottom(site, sections) %}{% endmacro %}
