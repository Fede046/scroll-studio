    "steps": [
     {
      "kicker": "Cellwright Bio",
      "title": "From tissue <em>to molecule.</em>",
      "body": "We design medicines at the scale where disease actually begins. Scroll down through six orders of magnitude, from a field of cells to a single gene.",
      "fact": null,
      "at": null,
      "length": 1.2,
      "intro": true,
      "hint": "Scroll to zoom in",
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     },
     {
      "kicker": "01 / 05 · 100 µm",
      "title": "Disease starts <em>small.</em>",
      "body": "Long before symptoms, something changes in a tissue: a few cells behaving differently from their neighbours.",
      "fact": "Fluorescence imaging: membranes in green, nuclei in blue.",
      "at": null,
      "length": 1.2,
      "intro": false,
      "hint": null,
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     },
     {
      "kicker": "02 / 05 · 10 µm",
      "title": "Inside <em>one cell.</em>",
      "body": "Mitochondria power it, vesicles move cargo, and at the centre the nucleus holds the instructions for all of it.",
      "fact": "A typical human cell is about 10 micrometres across.",
      "at": null,
      "length": 1.5,
      "intro": false,
      "hint": null,
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     },
     {
      "kicker": "03 / 05 · 1 µm",
      "title": "The genome, <em>unwound.</em>",
      "body": "Two metres of DNA packed into a nucleus a hundred times narrower than a hair, folded so the right genes stay within reach.",
      "fact": "Chromatin: DNA wrapped around proteins, coiled and looped.",
      "at": null,
      "length": 1.3,
      "intro": false,
      "hint": null,
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     },
     {
      "kicker": "04 / 05 · 2 nm",
      "title": "Reading <em>the code.</em>",
      "body": "Down at the double helix, every disease variant is a precise address: a handful of letters in three billion.",
      "fact": "The helix is 2 nanometres wide and turns once every 10.5 base pairs.",
      "at": null,
      "length": 1.5,
      "intro": false,
      "hint": null,
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     },
     {
      "kicker": "05 / 05 · 0.3 nm",
      "title": "One target. <em>One molecule.</em>",
      "body": "We design compounds that find that address and bind it, and nothing else. This is where a medicine begins.",
      "fact": "Designed against structure, validated in patient-derived cells.",
      "at": null,
      "length": 1.6,
      "intro": false,
      "hint": null,
      "place": null,
      "surface": null,
      "button": null,
      "image": null,
      "state": {}
     }
